# FirstQueue environment file
#
# Copy this to .env and fill in your own values:
#     cp .env.example .env
#     chmod 600 .env
#
# .env is in .gitignore and must never be committed. If you ever paste a real
# token somewhere public, revoke it immediately — see SECURITY.md.
#
# systemd reads this file directly (EnvironmentFile=), so use KEY=value with
# no "export", no spaces around "=", and no quotes unless the value needs them.

# --- Apify -----------------------------------------------------------------
# Apify Console -> Settings -> API & Integrations -> Personal API token.
# Starts with apify_api_...
APIFY_API_TOKEN=

# --- Telegram --------------------------------------------------------------
# From @BotFather after /newbot. Keep this value private.
TELEGRAM_BOT_TOKEN=

# Your own numeric chat ID — NOT your @username.
# Message your new bot once, then open:
#   https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# and read result[0].message.chat.id
TELEGRAM_CHAT_ID=

# --- Optional --------------------------------------------------------------
# Set to 1 to skip the weekday/hour/holiday guards for a single manual test run.
# Leave empty or unset in production.
IGNORE_SCHEDULE_GUARDS=

# Set to 1 to enable the optional semantic embedding model.
# Requires: pip install -r requirements-semantic.txt
# Needs roughly 300MB more RAM — check your VPS can take it first.
ENABLE_EMBEDDING_MODEL=0
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
